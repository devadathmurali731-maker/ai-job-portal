{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Description Schema",
  "description": "Standardized schema for storing job description information",
  "type": "object",

  "required": [
    "job_id",
    "job_title",
    "company",
    "required_skills"
  ],

  "properties": {
    "job_id": {
      "type": "string"
    },

    "job_title": {
      "type": "string"
    },

    "company": {
      "type": "string"
    },

    "location": {
      "type": "string"
    },

    "employment_type": {
      "type": "string"
    },

    "job_summary": {
      "type": "string"
    },

    "minimum_experience_years": {
      "type": "number",
      "minimum": 0
    },

    "maximum_experience_years": {
      "type": "number",
      "minimum": 0
    },

    "required_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_requirement"
      }
    },

    "preferred_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill_requirement"
      }
    },

    "education_requirements": {
      "type": "array",
      "items": {
        "type": "object",

        "required": [
          "degree",
          "field_of_study"
        ],

        "properties": {
          "degree": {
            "type": "string"
          },

          "field_of_study": {
            "type": "string"
          }
        }
      }
    },

    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },

  "$defs": {

    "skill_requirement": {
      "type": "object",

      "required": [
        "name",
        "category",
        "importance"
      ],

      "properties": {
        "name": {
          "type": "string"
        },

        "category": {
          "type": "string"
        },

        "importance": {
          "type": "string",
          "enum": [
            "mandatory",
            "preferred"
          ]
        },

        "minimum_years": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}