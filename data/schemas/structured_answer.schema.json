
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day 25 Structured Candidate Answer",
  "description": "Schema for semantically analyzed candidate screening answers",
  "type": "object",
  "required": [
    "answer_id",
    "question_id",
    "question_type",
    "original_text",
    "intent",
    "entities",
    "is_off_topic",
    "answer_status",
    "is_vague",
    "missing_fields"
  ],
  "properties": {
    "answer_id": {
      "type": ["string", "null"]
    },
    "question_id": {
      "type": ["string", "null"]
    },
    "question_type": {
      "type": "string"
    },
    "original_text": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": ["intent", "confidence", "matched_keywords"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "skills",
            "experience",
            "availability",
            "salary_expectation",
            "general",
            "missing"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matched_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "required": [
        "skills",
        "experience",
        "availability",
        "salary_expectation"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experience": {
          "type": "object",
          "properties": {
            "value": {
              "type": ["number", "null"]
            },
            "unit": {
              "type": ["string", "null"]
            }
          }
        },
        "availability": {
          "type": "object",
          "properties": {
            "type": {
              "type": ["string", "null"]
            },
            "value": {
              "type": ["number", "null"]
            },
            "unit": {
              "type": ["string", "null"]
            }
          }
        },
        "salary_expectation": {
          "type": "object",
          "properties": {
            "amount": {
              "type": ["integer", "null"]
            },
            "currency": {
              "type": ["string", "null"]
            },
            "period": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "is_off_topic": {
      "type": "boolean"
    },
    "off_topic_reason": {
      "type": "string"
    },
    "answer_status": {
      "type": "string",
      "enum": [
        "complete",
        "missing",
        "vague",
        "off_topic"
      ]
    },
    "is_vague": {
      "type": "boolean"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
